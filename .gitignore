node_modules
dist
*.log

# Server database, sessions and the generated admin password.
server/data
.env
.env.*
!.env.example

# Art is kept out of git (5.5 GB raw pack). Only the pack's README and the scripts that
# build its sprite sheets are tracked; game/public/assets is generated by `npm run assets`.
assets/*
!assets/README.md
!assets/tospritesheet.py
!assets/build_sprites.sh
game/public/assets

# Rendered output and copied art of the roadmap video project.
roadmap-video/out
roadmap-video/public

# Cloudflare: local D1/dev state, local secrets (ADMIN_PASSWORD for wrangler dev).
.wrangler
.dev.vars
