// Cloudflare Worker: the API only (Hono, D1, Durable Objects). The game, admin panel and
// website are separate static Workers (game/, admin/, website/). See DEPLOY.md and RELEASING.md.
// Wrangler envs don't inherit bindings, so env.staging repeats them.
// `npm run dev` (local) overrides ALLOWED_ORIGINS and sets DEV with --var; see package.json.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tower-rush",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.crownnkeep.com", "custom_domain": true }],
  // Keep tower-rush.philiplouis0717.workers.dev alive: old bookmarks get a 301 to the game.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tower-rush",
      "database_id": "8633ac1c-c935-448e-9473-05d5554e6df3",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in attempts per IP per minute.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // PvP: one matchmaker plus one room per match (src/pvp.ts, PVP.md).
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "MATCH", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker", "MatchRoom"] }],
  // Cloudflare Email Service: sends from noreply@crownnkeep.com (src/email.ts).
  "send_email": [{ "name": "EMAIL" }],
  // ALLOWED_ORIGINS: browser origins for CORS and WebSocket upgrades (comma list).
  // MIN_CLIENT: oldest game version still served; older clients get 426 and must reload.
  // GAME_URL: where non-API requests are redirected.
  // TURNSTILE_SITEKEY / TURNSTILE_HOSTNAMES: the bot-check widget and the game hostnames its tokens may come from.
  // INVITE_ONLY ("1", staging only): new accounts only through admin invites, no guest play.
  "vars": {
    "ADMIN_USERNAME": "admin",
    "ALLOWED_ORIGINS": "https://game.crownnkeep.com,https://manage.crownnkeep.com",
    "MIN_CLIENT": "2.5.0",
    "GAME_URL": "https://game.crownnkeep.com/",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFUwTM4HbhgRHLCK",
    "TURNSTILE_HOSTNAMES": "game.crownnkeep.com"
  },
  // Secrets (not in this file): ADMIN_PASSWORD, used once to create the first admin;
  // TURNSTILE_SECRET, the Turnstile widget's secret key.
  "env": {
    "staging": {
      "name": "tower-rush-staging",
      "routes": [{ "pattern": "staging-api.crownnkeep.com", "custom_domain": true }],
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tower-rush-staging",
          "database_id": "7a9cd407-6eb7-415e-8367-d00309e64e97",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ADMIN_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
          { "name": "MATCH", "class_name": "MatchRoom" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker", "MatchRoom"] }],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "ADMIN_USERNAME": "admin",
        "ALLOWED_ORIGINS": "https://staging-game.crownnkeep.com,https://manage.crownnkeep.com,http://localhost:5173,http://localhost:5174",
        "MIN_CLIENT": "2.7.0",
        "GAME_URL": "https://staging-game.crownnkeep.com/",
        "TURNSTILE_SITEKEY": "0x4AAAAAAFUwTM4HbhgRHLCK",
        "TURNSTILE_HOSTNAMES": "staging-game.crownnkeep.com",
        "INVITE_ONLY": "1"
      }
    }
  }
}
